# Hinglish Card Assistant Environment Configuration
# Copy this file to .env and fill in your keys

# LLM Provider: groq | sarvam | mock
LLM_PROVIDER=mock

# API Keys (leave empty when using LLM_PROVIDER=mock)
GROQ_API_KEY=
SARVAM_API_KEY=

# Intent Classifier: mock | service
# Use 'mock' until muril_intent.zip is downloaded & unzipped into model_service/muril_intent/
INTENT_MODE=mock
INTENT_SERVICE_URL=http://localhost:8000

# Voice Provider: groq | sarvam | browser | mock
VOICE_PROVIDER=mock

# Phase 2 Banking Model directory (optional override)
# INTENT_MODEL_DIR=./model_service/muril_banking
